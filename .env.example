# Newsletter endpoint. Leave empty to run the signup form in DEMO MODE (nothing is sent anywhere).
# See README.md > "Connecting the newsletter" for Buttondown / Mailchimp / ConvertKit (Kit) setups.
VITE_NEWSLETTER_ENDPOINT=
# "json" (default) posts {"email": "..."} as application/json. "form" posts email=... as form data.
VITE_NEWSLETTER_FORMAT=json
# Public site URL, used for canonical links.
VITE_SITE_URL=https://offlinetheory.example
