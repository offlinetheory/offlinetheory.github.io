# Optional override for the newsletter Magic Link base URL.
# Default (when empty): beehiiv's public Magic Link, no API key.
# The address is appended as the email query parameter and POSTed as signup[email].
# See README.md > "Connecting the newsletter".
VITE_NEWSLETTER_ENDPOINT=
# Public site URL, used for canonical links.
VITE_SITE_URL=https://offlinetheory.github.io
